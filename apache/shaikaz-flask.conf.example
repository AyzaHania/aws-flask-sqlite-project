# Apache virtual host for the EC2 Flask student portal, reflecting the verified server config.
# Update both addresses if the instance's public IPv4 address changes.
<VirtualHost *:80>
    ServerName ec2-18-225-218-211.us-east-2.compute.amazonaws.com
    ServerAlias 18.225.218.211

    WSGIDaemonProcess shaikaz-flask python-path=/home/ubuntu/shaikaz-flask
    WSGIProcessGroup shaikaz-flask
    WSGIScriptAlias / /home/ubuntu/shaikaz-flask/flaskapp.wsgi

    <Directory /home/ubuntu/shaikaz-flask>
        Require all granted
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/shaikaz-flask-error.log
    CustomLog ${APACHE_LOG_DIR}/shaikaz-flask-access.log combined
</VirtualHost>
